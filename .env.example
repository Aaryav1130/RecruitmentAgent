# ━━━ LLM (Required) ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ━━━ LiveKit (Required for Live Interview) ━━━━━━━━━━━━━━
# Sign up at: https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ━━━ Bey AI Avatar (Optional — for animated interviewer) ━
# Sign up at: https://bey.dev
BEY_API_KEY=your_bey_api_key
BEY_AVATAR_ID=2ed7477f-3961-4ce1-b331-5e4530c55a57

# ━━━ SerpAPI (Optional — Job Search Fallback) ━━━━━━━━━━━
# Sign up at: https://serpapi.com (100 free searches/month)
SERPAPI_API_KEY=your_serpapi_key_here